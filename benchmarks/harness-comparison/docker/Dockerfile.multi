FROM python:3.12-slim
RUN apt-get update && apt-get install -y curl wget git unzip && \
    pip install --no-cache-dir pytest pyyaml && \
    # Install Terraform
    wget -q https://releases.hashicorp.com/terraform/1.9.0/terraform_1.9.0_linux_amd64.zip && \
    unzip terraform_1.9.0_linux_amd64.zip && mv terraform /usr/local/bin/ && \
    rm terraform_1.9.0_linux_amd64.zip && \
    # Install kubectl
    curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && mv kubectl /usr/local/bin/ && \
    # Install Helm
    curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash && \
    # Install hadolint
    wget -q https://github.com/hadolint/hadolint/releases/download/v2.12.0/hadolint-Linux-x86_64 && \
    chmod +x hadolint-Linux-x86_64 && mv hadolint-Linux-x86_64 /usr/local/bin/hadolint && \
    # Install checkov, ansible
    pip install --no-cache-dir checkov ansible ansible-lint molecule
WORKDIR /workspace
