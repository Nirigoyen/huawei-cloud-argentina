# LLM endpoint (OpenAI-compatible)
OPENAI_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=deepseek-v3.2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STREAMING=true

# Database (internal docker network — do not change for docker compose)
DATABASE_URL=postgresql+asyncpg://workshop:workshop@postgres:5432/app_metadata

# Wren paths (internal container paths)
WREN_HOME=/app/.wren
WREN_PROJECTS_DIR=/app/wren_projects

# CORS (frontend external port)
CORS_ORIGINS=http://localhost:8080

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=changeme-to-a-long-random-string

# Frontend API URL (proxied through Next.js in docker)
NEXT_PUBLIC_API_URL=/api
