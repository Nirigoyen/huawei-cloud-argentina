# ---- OpenAI-compatible endpoint (organizers provide this) ----
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=changeme
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Metadata DB (app state) ----
DATABASE_URL=postgresql+asyncpg://workshop:workshop@localhost:5432/app_metadata

# ---- Wren home (profiles + projects). Per-app to avoid clobbering ~/.wren ----
WREN_HOME=./.wren

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Session ----
SESSION_SECRET=changeme-to-a-long-random-string
