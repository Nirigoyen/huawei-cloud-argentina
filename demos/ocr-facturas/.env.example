# ============================================================================
# OCR Facturas — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (Application Database)
# -----------------------------------------------------------------------------
POSTGRES_USER=ocrfacturas
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=ocrfacturas

# Full database URL (used by SQLAlchemy async driver)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://ocrfacturas:your-postgres-password@postgres:5432/ocrfacturas

# Separate URL for chatbot read-only queries
CHATBOT_DATABASE_URL=postgresql+asyncpg://ocrfacturas:your-postgres-password@postgres:5432/ocrfacturas

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
# Admin login credentials (single-user MVP)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# JWT secret key (use a strong random string in production)
JWT_SECRET_KEY=your-jwt-secret-key

# Dify Console login (for workflow configuration API)
DIFY_CONSOLE_EMAIL=your-dify-console-email
DIFY_CONSOLE_PASSWORD=your-dify-console-password

# Port exposed on the host
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Directory for uploaded invoice files (inside container)
UPLOAD_DIR=/app/uploads

# Maximum file upload size in megabytes
MAX_FILE_SIZE_MB=15

# OCR workflow timeout in seconds
OCR_TIMEOUT_SECONDS=120

# Chatbot query execution timeout in seconds
CHATBOT_QUERY_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Huawei Cloud — IAM Authentication
# These credentials are injected into the Dify OCR workflow at runtime.
# -----------------------------------------------------------------------------
HWCLOUD_IAM_USERNAME=your-iam-username
HWCLOUD_IAM_PASSWORD=your-iam-password
HWCLOUD_PROJECT_ID=your-project-id
HWCLOUD_REGION=ap-southeast-1

# -----------------------------------------------------------------------------
# Dify Integration
# -----------------------------------------------------------------------------
DIFY_BASE_URL=http://dify-api:5001
DIFY_API_KEY=your-dify-api-key
DIFY_WORKFLOW_ID=

# -----------------------------------------------------------------------------
# MaaS — Huawei Cloud Model-as-a-Service (OpenAI-compatible API)
# Used by the chatbot engine for intent classification and response generation.
# -----------------------------------------------------------------------------
MAAS_API_KEY=your-maas-api-key
MAAS_BASE_URL=https://maas.ap-southeast-1.myhuaweicloud.com/v1
MAAS_MODEL_NAME=deepseek-v3

# -----------------------------------------------------------------------------
# Dify Internal Configuration
# These are used by the Dify Docker services (dify-api, dify-worker, dify-web).
# -----------------------------------------------------------------------------
DIFY_SECRET_KEY=your-dify-secret-key
DIFY_DB_USERNAME=dify
DIFY_DB_PASSWORD=your-dify-db-password
DIFY_DB_NAME=dify
DIFY_REDIS_PASSWORD=
CELERY_BROKER_URL=redis://dify-redis:6379/1
DIFY_VECTOR_TYPE=weaviate
DIFY_WEAVIATE_ENDPOINT=http://dify-weaviate:8080
DIFY_SANDBOX_API_KEY=your-sandbox-api-key
DIFY_CONSOLE_API_URL=http://localhost:3001
DIFY_APP_API_URL=http://localhost:3001
DIFY_PLUGIN_DAEMON_KEY=your-plugin-daemon-key

# -----------------------------------------------------------------------------
# HTTP Proxy (optional — for external API calls from within Docker)
# -----------------------------------------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,dify-api,dify-worker,dify-web,dify-db,dify-redis,dify-plugin-daemon

# -----------------------------------------------------------------------------
# Destination Database (Data Forward)
# Configure a destination database to forward extracted invoice data.
# Supported types: postgresql, mysql
# -----------------------------------------------------------------------------
DESTINATION_DB_TYPE=
DESTINATION_DB_HOST=
DESTINATION_DB_PORT=
DESTINATION_DB_NAME=
DESTINATION_DB_USERNAME=
DESTINATION_DB_PASSWORD=
DESTINATION_DB_TABLE=invoices
DATA_FORWARD_ENABLED=false
DATA_FORWARD_URL=
